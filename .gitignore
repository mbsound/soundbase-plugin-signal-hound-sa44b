node_modules/
dist/

# frozen language runtimes assembled per target — large, binary, never committed
runtime/

# CPython bytecode, regenerated per interpreter version
__pycache__/
*.pyc

# host builds of the worker are for local mock runs; scripts/build-worker.sh
# makes them. The worker that ships is in driver/microvm/guest/x86/.
driver/worker/bin/

# Signal Hound's Linux SA API, fetched by the plugin on first open (older
# checkouts kept a copy here)
sdk/

# intermediate downloads and objects of the macOS runtime builds; the
# outputs under driver/bridge/bin, driver/microvm/bin and driver/microvm/guest
# are committed because the release zip is made of tracked files
build/
