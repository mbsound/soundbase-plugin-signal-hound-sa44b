{
  "manifestVersion": 1,
  "id": "signal-hound-sa44b",
  "name": "Signal Hound SA44B",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "platforms": [
    "darwin-arm64",
    "win32-x64"
  ],
  "repository": "https://github.com/mbsound/soundbase-plugin-signal-hound-sa44b",
  "maintainers": [
    {
      "name": "Matt Bell",
      "email": "matt@mbsound.org"
    }
  ],
  "contract": {
    "core": "1.4",
    "modules": {
      "SpectrumAnalyzer": "1.2"
    }
  },
  "runtime": {
    "type": "node",
    "entrypoint": "main.js"
  },
  "deployment": [
    "managed"
  ],
  "template": {
    "name": "soundbase-plugin-template",
    "version": "1.0.15"
  },
  "products": [
    {
      "deviceTypeId": "plugin:signal-hound-sa44b/sa44b",
      "manufacturer": {
        "id": "signal-hound",
        "name": "Signal Hound"
      },
      "model": {
        "id": "sa44b",
        "name": "SA44B",
        "displayName": "Signal Hound SA44B"
      },
      "family": {
        "id": "signal-hound-sa",
        "name": "Signal Hound SA series"
      },
      "capabilities": {
        "spectrumAnalyzer": true
      },
      "traits": {
        "isSpectrumAnalyzer": true
      }
    }
  ],
  "deviceConfigFields": [
    {
      "id": "serial",
      "type": "number",
      "label": "Serial number",
      "manualOnly": true,
      "help": "The unit's serial number, as printed on the label. Leave empty to open the first SA44B found."
    }
  ],
  "pluginConfigFields": [
    {
      "id": "sdkPath",
      "type": "textinput",
      "label": "SA API folder",
      "help": "Folder containing sa_api.dll and ftd2xx.dll. Leave empty to use the copies installed with Spike (C:\\Program Files\\Signal Hound\\Spike)."
    }
  ],
  "stateKeys": []
}
